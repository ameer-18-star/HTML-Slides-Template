<section class="slide cta-slide glow-tr" id="{{ slug }}">
  {{ m.watermark() }}
  <div class="slide-inner">

    <h1 class="cta-heading reveal">{{ heading }}</h1>

    <p class="cta-sub reveal">{{ subtext }}</p>

    <div class="cta-cards">
      {% for card in cards %}
      <div class="cta-card{{ ' cc-primary' if card.primary else '' }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="{{ '#FFF600' if card.primary else '#F3F3F3' }}">
          {{ (icons[card.label|lower] if card.label|lower in icons else icons["like"]) | safe }}
        </svg>
        <div class="cc-label">{{ card.label }}</div>
      </div>
      {% endfor %}
    </div>

    <p class="cta-tagline reveal">{{ tagline }}</p>

  </div>
</section>
