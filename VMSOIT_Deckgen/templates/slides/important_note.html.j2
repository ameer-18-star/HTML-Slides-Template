{% import "slides/_macros.html.j2" as m %}
<section class="slide note-slide" id="{{ slug }}">
  {{ m.watermark() }}
  <div class="slide-inner">

    {{ m.eyebrow(eyebrow, index) }}

    <div class="note-card{{ ' note-danger' if variant == 'danger' else '' }}">
      <div class="note-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="{{ '#D7263D' if variant == 'danger' else '#FFF600' }}">
          <path d="M236.8,188.09,149.35,36.22a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM120,104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm8,88a12,12,0,1,1,12-12A12,12,0,0,1,128,192Z" />
        </svg>
      </div>
      <div class="note-body-wrap">
        <div class="note-label">{{ label }}</div>
        <div class="note-headline">{{ headline }}</div>
        <p class="note-detail">{{ detail }}</p>
      </div>
    </div>

  </div>

  {{ m.footer_bar(footer_label) }}
</section>
