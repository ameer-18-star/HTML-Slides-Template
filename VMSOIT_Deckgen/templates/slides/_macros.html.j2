{# ============================================================
   _macros.html.j2
   Shared building blocks reused across the 23 slide templates so the
   chevron SVG / footer bar / eyebrow markup isn't duplicated 23 times.
   Import with: {% import "slides/_macros.html.j2" as m %}
   ============================================================ #}

{% macro chevron(color="#FFF600", width="3.5", class="chev") -%}
<svg class="{{ class }}" viewBox="0 0 24 16" fill="none">
  <path d="M2 2L12 12L22 2" stroke="{{ color }}" stroke-width="{{ width }}" stroke-linecap="round" stroke-linejoin="round" />
</svg>
{%- endmacro %}

{% macro eyebrow(text, index) -%}
<p class="eyebrow reveal">
  {{ chevron() }}
  {{ text }}
  <span class="idx">&nbsp;&middot;&nbsp; {{ "%02d"|format(index) }}</span>
</p>
{%- endmacro %}

{% macro footer_bar(label) -%}
<div class="footer-bar">
  <span class="fb-logo"><img src="vmsoit-logo.png" alt="" />VMSOIT</span>
  <span>{{ label }}</span>
</div>
{%- endmacro %}

{% macro watermark() -%}
<img class="watermark" src="vmsoit-logo.png" alt="" />
{%- endmacro %}

